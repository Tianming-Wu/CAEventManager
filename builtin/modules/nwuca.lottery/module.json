{
  "id": "nwuca.lottery",
  "name": "奖票抽奖",
  "version": "1.0.0",
  "api": 1,
  "author": "Tianming",
  "homepage": "https://github.com/Tianming-Wu/CAEventManager",
  "license": "MIT",
  "builtin": true,
  "requires": ">=1.4",
  "description": "签到与任务发奖票，按票抽奖，另有一次到场均等抽特等奖",
  "external": [
    "board",
    "screen",
    "checkin",
    "admin"
  ],
  "pages": [
    {
      "id": "ops",
      "title": "操作台"
    },
    {
      "id": "roster",
      "title": "名单"
    },
    {
      "id": "tickets",
      "title": "奖票"
    },
    {
      "id": "draw",
      "title": "抽奖"
    },
    {
      "id": "config",
      "title": "奖票设置"
    }
  ],
  "features": {
    "search": {
      "records": "students",
      "name": "name",
      "key": "sid",
      "fields": [
        "grp",
        "note"
      ],
      "tags": [
        {
          "keys": [
            "w",
            "worker",
            "staff",
            "工作人员"
          ],
          "label": "#w 工作人员",
          "field": "role",
          "eq": "staff"
        },
        {
          "keys": [
            "v",
            "volunteer",
            "志愿者"
          ],
          "label": "#v 志愿者",
          "field": "role",
          "eq": "volunteer"
        },
        {
          "keys": [
            "p",
            "participant",
            "参加人员"
          ],
          "label": "#p 参加人员",
          "field": "role",
          "eq": "participant"
        },
        {
          "keys": [
            "已签到",
            "in"
          ],
          "label": "#已签到",
          "field": "marks.checkin",
          "filled": true
        },
        {
          "keys": [
            "未签到",
            "out"
          ],
          "label": "#未签到",
          "field": "marks.checkin",
          "filled": false
        },
        {
          "keys": [
            "已完成",
            "done"
          ],
          "label": "#已完成",
          "field": "tasks",
          "atLeast": 2
        },
        {
          "keys": [
            "未完成",
            "todo"
          ],
          "label": "#未完成",
          "field": "tasks",
          "below": 2
        },
        {
          "keys": [
            "有票",
            "ticket"
          ],
          "label": "#有票",
          "list": "tickets",
          "filled": true
        },
        {
          "keys": [
            "无票",
            "zeroticket"
          ],
          "label": "#无票",
          "list": "tickets",
          "filled": false
        }
      ]
    },
    "shortlink": {}
  },
  "actions": {
    "mark": {
      "title": "标记完成",
      "args": {
        "student": {
          "type": "int",
          "required": true
        },
        "kind": {
          "type": "str",
          "required": true,
          "max": 16
        },
        "at": {
          "type": "float"
        }
      },
      "seat": "member",
      "unlock": false,
      "target": "student:{student}"
    },
    "undo": {
      "title": "撤销标记",
      "args": {
        "student": {
          "type": "int",
          "required": true
        },
        "kind": {
          "type": "str",
          "required": true,
          "max": 16
        }
      },
      "seat": "member",
      "unlock": true,
      "target": "student:{student}"
    },
    "set_time": {
      "title": "改签到时间",
      "args": {
        "student": {
          "type": "int",
          "required": true
        },
        "kind": {
          "type": "str",
          "required": true,
          "max": 16
        },
        "at": {
          "type": "float",
          "required": true
        }
      },
      "seat": "member",
      "unlock": true,
      "target": "student:{student}"
    },
    "add_student": {
      "title": "手动加人",
      "args": {
        "sid": {
          "type": "str",
          "required": true,
          "max": 32
        },
        "name": {
          "type": "str",
          "required": true,
          "max": 40
        },
        "grp": {
          "type": "str",
          "max": 40
        },
        "note": {
          "type": "str",
          "max": 200
        },
        "role": {
          "type": "str",
          "max": 16
        }
      },
      "seat": "member",
      "unlock": false,
      "target": "roster"
    },
    "update_student": {
      "title": "改学生资料",
      "args": {
        "id": {
          "type": "int",
          "required": true
        },
        "name": {
          "type": "str",
          "max": 40
        },
        "grp": {
          "type": "str",
          "max": 40
        },
        "note": {
          "type": "str",
          "max": 200
        },
        "role": {
          "type": "str",
          "max": 16
        }
      },
      "seat": "member",
      "unlock": false,
      "target": "student:{id}"
    },
    "delete_student": {
      "title": "移出学生",
      "args": {
        "id": {
          "type": "int",
          "required": true
        }
      },
      "seat": "member",
      "unlock": true,
      "target": "student:{id}"
    },
    "finalize": {
      "title": "结算奖票",
      "args": {},
      "seat": "owner",
      "unlock": true,
      "target": "draw"
    },
    "unfinalize": {
      "title": "取消结算",
      "args": {},
      "seat": "owner",
      "unlock": true,
      "target": "draw"
    },
    "reset_tickets": {
      "title": "重置奖票",
      "args": {},
      "seat": "owner",
      "unlock": true,
      "target": "draw"
    }
  }
}
